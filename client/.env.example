# ==============================================================================
# 쭌이형제네 AI 평가 환경 설정 예시 (.env.example)
# ==============================================================================

# Google Gemini API 설정 (https://aistudio.google.com/app/apikey)
# 또는 애플리케이션 상단 [AI 설정] 모달에서 직접 등록하여 사용 가능
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-3.8-flash

# Firebase 환경 (로컬 개발 시 에뮬레이터 사용 여부)
VITE_USE_FIREBASE_EMULATOR=false
